# Google Sheets (registration + contact-us storage)
# Create a Google Cloud service account with the Sheets API enabled,
# then share the target spreadsheet with the service account's email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Salt used to generate the registration confirmation hash
REG_SALT=

# Firebase (member application storage — Firestore + Storage)
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=asymmetric-2b3be
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=asymmetric-2b3be.firebasestorage.app

# CORS origin(s) allowed to call this API (comma separated)
CORS_ORIGIN=http://localhost:3001
